<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rag_import_wizard_form" model="ir.ui.view">
        <field name="name">rag.import.wizard.form</field>
        <field name="model">rag.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Impor Dataset Roma 8">
                <group>
                    <group>
                        <field name="file_data" filename="file_name"/>
                        <field name="file_name" invisible="1"/>
                    </group>
                    <group>
                        <field name="source_path" placeholder="/opt/odoo18/addons/rag_teologi/data/roma8.json"/>
                        <field name="reset_variants"/>
                    </group>
                </group>
                <div class="alert alert-info" role="alert">
                    Impor ini hanya mengisi <b>kitab, perikop, ayat, dan varian</b>.
                    Chunking dan embedding dijalankan pada tahap berikutnya.
                </div>
                <footer>
                    <button name="action_import" type="object" string="Impor" class="btn-primary"/>
                    <button string="Batal" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_rag_import_wizard" model="ir.actions.act_window">
        <field name="name">Impor Dataset</field>
        <field name="res_model">rag.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
