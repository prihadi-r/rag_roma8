<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- Aksi server: proses antrean embedding -->
        <record id="action_server_rag_embed" model="ir.actions.server">
            <field name="name">RAG: Embedding Chunk</field>
            <field name="model_id" ref="model_rag_chunk"/>
            <field name="state">code</field>
            <field name="code">model._cron_embed(limit=64)</field>
        </record>

        <!-- Dijalankan tiap 5 menit; hanya memproses chunk yang menunggu -->
        <record id="ir_cron_rag_embed" model="ir.cron">
            <field name="name">RAG: Embedding Chunk</field>
            <field name="ir_actions_server_id" ref="action_server_rag_embed"/>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>

    </data>
</odoo>
